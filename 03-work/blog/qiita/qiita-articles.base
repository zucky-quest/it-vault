filters:
  and:
    - file.inFolder("03-work/blog/qiita")
    - file.ext == "md"
    - 'file.name != "0-index"'
formulas:
  status: 'if(published, "公開済み", "下書き")'
properties:
  file.name:
    displayName: 記事
  published:
    displayName: 公開
  formula.status:
    displayName: ステータス
  topics:
    displayName: トピック
  file.mtime:
    displayName: 更新日
views:
  - type: table
    name: すべて
    order:
      - file.name
      - published
      - formula.status
      - topics
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    summaries:
      published: Checked
  - type: table
    name: 公開済み
    filters:
      and:
        - published == true
    order:
      - file.name
      - published
      - formula.status
      - topics
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: 下書き
    filters:
      and:
        - published != true
    order:
      - file.name
      - published
      - formula.status
      - topics
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
